# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket CLOB API (optional — for live trading)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
# Polymarket deposit wallet address
POLYMARKET_FUNDER_ADDRESS=
# Signature type: 3 = POLY_1271 deposit wallet (default, verified working), 1 = email/Magic proxy / POLY_PROXY, 2 = browser wallet Gnosis Safe proxy, 0 = plain EOA
POLYMARKET_SIGNATURE_TYPE=3

# Polygon RPC (optional — read-only on-chain balance fallback, see
# locus/core/onchain.py). Empty disables it entirely; every caller behaves
# exactly as if this feature didn't exist. Set to an Alchemy (or any
# JSON-RPC) Polygon mainnet endpoint to enable. Never logged in full.
POLYGON_RPC_URL=
ONCHAIN_RPC_TIMEOUT_SECONDS=10
ONCHAIN_RPC_RETRIES=2
# When a live SELL's order-ledger reconcile can't confirm the fill, the
# on-chain token balance arbitrates before the close is declared failed.
BALANCE_CONFIRM_RETRIES=3
BALANCE_CONFIRM_WAIT_SECONDS=2

# Twitter API v2 (optional — real-time news stream)
TWITTER_BEARER_TOKEN=

# Telegram Bot (optional — channel monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=

# NewsAPI.org (optional — broader news coverage)
NEWSAPI_KEY=

# Pipeline Settings
# Paper mode (default). See LOCUS_LIVE_ACK below for live trading.
DRY_RUN=true
MAX_BET_USD=25
# Caps total notional deployed per day, not realized losses
DAILY_SPEND_LIMIT_USD=100
EDGE_THRESHOLD=0.10

# Price-room guards (edge.detect_edge_v2): skip signals priced outside the band
# where the direction has historically paid.
# Bullish (YES): min raised from 0.05 to 0.12 — markets under 0.15 grade only
# 5.8% accurate (longshot lottery tickets); max tightened from 0.85 to 0.82
# (little room left to profit above it).
BULLISH_MIN_PRICE=0.12
BULLISH_MAX_PRICE=0.82
# Bearish (NO): min 0.18 — NO bets on very low-priced markets are risky; max
# kept wide at 0.88 since good NO edge exists in the 0.87-0.93 range.
BEARISH_MIN_PRICE=0.18
BEARISH_MAX_PRICE=0.88

# V2 Settings
MAX_VOLUME_USD=500000
MIN_VOLUME_USD=1000
SPEED_TARGET_SECONDS=5

# Freshness gate: trade only on news younger than these source-specific limits
# (seconds). Real-time feeds (Twitter) get a tight window; slower aggregators
# (RSS/NewsAPI) get more slack. MAX_NEWS_AGE_SECONDS is the fallback for
# unknown/unlisted sources.
MAX_NEWS_AGE_SECONDS=900
MAX_NEWS_AGE_SECONDS_TWITTER=900
MAX_NEWS_AGE_SECONDS_RSS=7200
MAX_NEWS_AGE_SECONDS_NEWSAPI=14400
MAX_NEWS_AGE_SECONDS_TELEGRAM=1800

# Direction- and category-aware materiality floors (pipeline.get_materiality_threshold:
# category wins first — geopolitical/sports — then direction; bearish accuracy is
# lower than bullish). The legacy MATERIALITY_THRESHOLD_BULLISH/_BEARISH and
# SPORTS_MATERIALITY_THRESHOLD vars are still honored as fallbacks if set.
MIN_MATERIALITY_DEFAULT=0.33
MIN_MATERIALITY_BULLISH=0.34
MIN_MATERIALITY_BEARISH=0.27
MIN_MATERIALITY_GEOPOLITICAL=0.30
MIN_MATERIALITY_SPORTS=0.40

# High-materiality confirmation gate: signals at/above HIGH_MATERIALITY_THRESHOLD
# need the same direction from MIN_CONFIRMING_SOURCES distinct sources within
# CONFIRMATION_WINDOW_HOURS, else they're held (action=needs_confirmation)
HIGH_MATERIALITY_THRESHOLD=0.5
CONFIRMATION_WINDOW_HOURS=2
MIN_CONFIRMING_SOURCES=2

# Event context: markets sharing a Gamma event_id are sibling outcomes. Cap how
# many positions may be open across one event (mutually-exclusive outcomes are
# highly correlated). 1 = one position per event.
MAX_POSITIONS_PER_EVENT=1

# Whale tracking: comma-separated wallet addresses to shadow. When a whale opens
# a position on a niche market we missed, the pipeline investigates it. Leave
# empty to disable. The remaining knobs tune polling cadence and thresholds.
WHALE_WALLETS=
WHALE_CHECK_INTERVAL_MINUTES=15
WHALE_LOOKBACK_MINUTES=30
WHALE_COOLDOWN_HOURS=6
WHALE_MIN_TRADE_USD=1000

# Re-entry: after a non-resolution close, keep watching the market for
# REENTRY_WATCH_HOURS and re-enter (at most MAX_REENTRY_PER_MARKET times) when a
# fresh classification clears the Re-entry 2.0 gate below. These two bound the
# watch window and the per-market re-entry budget.
REENTRY_WATCH_HOURS=72
MAX_REENTRY_PER_MARKET=1

# Re-entry 2.0 (exit_reason calibration): a granular re-entry gate keyed on the
# raw exit_reason. Allowed exits left a clean thesis (a take-profit decision, a
# manual close, a near-certain lock-in, a resolution); blocked exits mean the
# market beat us (drawdown, time pressure, hard stop, news reversal,
# already-priced-in). REENTRY_ENABLED is the master switch; the *_REASONS lists
# accept JSON arrays. Re-entries are sized down by REENTRY_SIZE_FACTOR, capped at
# REENTRY_MAX_PER_EVENT per event, held off for REENTRY_MIN_HOURS after the
# close, require materiality >= REENTRY_MIN_MATERIALITY, and are skipped when the
# market resolves within REENTRY_MIN_HOURS_TO_RESOLUTION hours.
REENTRY_ENABLED=true
REENTRY_ALLOWED_REASONS=["tp_decision", "manual", "near_certain_yes", "near_certain_no", "resolution"]
REENTRY_BLOCKED_REASONS=["drawdown_decision", "time_pressure", "news_decision", "already_priced_in", "hard_sl"]
REENTRY_MIN_MATERIALITY=0.45
REENTRY_MIN_HOURS=4
REENTRY_SIZE_FACTOR=0.7
REENTRY_MAX_PER_EVENT=1
REENTRY_MIN_HOURS_TO_RESOLUTION=12

# Circuit breaker: auto-pause trading when recent realized performance
# deteriorates. Trips when the rolling 7-day drawdown exceeds CIRCUIT_BREAKER_DD
# (fraction of peak) or the 7-day daily Sharpe falls below CIRCUIT_BREAKER_SHARPE.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_DD=0.20
CIRCUIT_BREAKER_SHARPE=-1.0
# Set to ISO date (2026-06-14) to ignore positions closed before this date
CIRCUIT_BREAKER_START_DATE=

# Dashboard
# Set to ISO date (2026-06-14) to hide old test positions from dashboard
DASHBOARD_POSITIONS_START_DATE=
# Set to ISO date (2026-06-14) to count only positions opened on/after it in the
# dashboard performance panel (closed count, win rate, PnL, deployed capital)
PERFORMANCE_START_DATE=

# --- Safety / execution (branch `improvements`) ---
# Live trading needs BOTH DRY_RUN=false (or `watch --live`) AND this exact ack:
# LOCUS_LIVE_ACK=I_UNDERSTAND_REAL_MONEY
LOCUS_LIVE_ACK=
# Never publish your book: auto git-push of docs/status.json is off by default.
AUTO_PUSH_STATUS=false
# No book -> no trade (fail closed)
ORDERBOOK_FAIL_OPEN=false
ORDERBOOK_FETCH_TIMEOUT_SECONDS=3
# Edge model: calibrated (default) | legacy
EDGE_MODEL=calibrated
CAL_EDGE_THRESHOLD=0.04
CAL_KELLY_FRACTION=0.5
# Slippage assumed when no book is supplied (backtests/tests only — the live
# pipeline requires a real book and fails closed without one).
DEFAULT_SLIPPAGE=0.01
CALIBRATION_MIN_CELL=30
CALIBRATION_PRIOR_STRENGTH=50
CALIBRATION_CACHE_TTL_SECONDS=900
# Momentum lookups are cached (and run off the event loop) — TTL in seconds.
MOMENTUM_CACHE_TTL_SECONDS=120
# Exit ladder (FAK sells walked down the bid book)
EXIT_LADDER_STEPS=3
EXIT_MAX_SLIPPAGE_PCT=8
STOP_LOSS_MAX_SLIPPAGE_PCT=20
EXIT_RETRY_DELAY_SECONDS=1.0

# --- Real-time Telegram news (MTProto user client) ---
# api_id / api_hash: https://my.telegram.org -> "API development tools".
# Create the session ONCE: python scripts/telegram_login.py --join
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=telegram_news.session
# Verified via t.me/s/<name> on 2026-10-29 (default list, no @):
TELEGRAM_NEWS_CHANNELS=WalterBloomberg,financialjuice,TreeNewsFeed,PolymarketIntel,WatcherGuru,wublockchainenglish,unfolded
# Also exist, not in the default list:
#   PolymarketNews  — last post 2026-10-25, less active
#   cointelegraph   — slower, article-style
#   tree_news       — exists but almost empty (TreeNewsFeed is the active one)
#   BRICSNews, disclosetv — very fast but sensational / often unverified
# RSS polls slower when a real-time source is configured:
RSS_INTERVAL_SECONDS=120
RSS_INTERVAL_WITH_REALTIME_SECONDS=300
